{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "test:unit": "vue-cli-service test:unit",
    "lint": "eslint .",
    "up": "(rm package-lock.json || del package-lock.json) && npm-check-updates --upgrade && npm install",
    "vue-up": "vue upgrade --next --all",
    "watch": "vue-cli-service build --watch"
  },
  "dependencies": {
    "@editorjs/editorjs": "^2.30.8",
    "dayjs": "^1.11.13",
    "quill": "^2.0.3",
    "vue": "^3.5.18",
    "vue-quill-editor": "^3.0.6",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/quill": "^2.0.14",
    "@vue/cli": "~5.0.8",
    "@vue/cli-plugin-router": "~5.0.8",
    "@vue/cli-plugin-typescript": "~5.0.8",
    "@vue/cli-plugin-unit-mocha": "~5.0.8",
    "@vue/cli-service": "~5.0.8",
    "@vue/compiler-sfc": "^3.5.18",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.6",
    "chai": "^5.2.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "lint-staged": "^16.1.5",
    "npm-check-updates": "^18.0.2",
    "sass": "^1.90.0",
    "sass-loader": "^16.0.5",
    "server": "file:../server",
    "typescript": "^5.9.2"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,vue,ts,tsx}": [
      "eslint --fix",
      "git add"
    ]
  }
}
